#!/bin/sh
# Block commits that reintroduce private registry references, cloud account IDs,
# or common internal-domain names. Keep the check quiet so sensitive staged lines
# are never echoed to the terminal.
if git diff --cached -- . ':(exclude).githooks/pre-commit' | grep -Eiq 'codeartifact|[[:digit:]]{12}|[[:alnum:]-]+\.(internal|corp)([^[:alnum:]]|$)'; then
  echo "" >&2
  echo "Blocked: private registry / cloud account identifier / internal domain found in staged changes." >&2
  echo "Scrub it before committing." >&2
  exit 1
fi
exit 0
